# PostgreSQL
# Async (API): use postgresql+asyncpg://
# Sync (Alembic/cron helpers): use postgresql+psycopg2://
# For Neon, either URL works; the app strips sslmode/channel_binding for asyncpg and
# sets ssl + statement_cache_size=0 automatically for pooler / neon.tech hosts.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/remote_atlas
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/remote_atlas
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# AI providers (server-side only). Fallback: Gemini1 → Gemini2 → DeepSeek → Perplexity
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# Optional curated jobs (higher rate with key): https://www.themuse.com/developers/api/v2/apps
THE_MUSE_API_KEY=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only jobs younger than this many days remain in the active index (posted_at, else first_seen_at).
FRESHNESS_DAYS=14
INGEST_CONCURRENCY=8
EMBED_BATCH_SIZE=800
# gemini | local | auto (auto prefers local when installed)
EMBED_PROVIDER=local
